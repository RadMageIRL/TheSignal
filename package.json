{
  "name": "the-signal",
  "version": "0.1.0",
  "private": true,
  "description": "The Signal: a global news and media headline aggregator. One world. Many perspectives. Draw your own conclusions.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4391 --strictPort",
    "test": "vitest run",
    "validate:sources": "node tools/validate-sources.ts",
    "snapshot:prototype": "node tools/make-snapshot.ts",
    "test:e2e": "playwright test",
    "fixture": "node tools/make-fixture.ts",
    "registry:check": "node tools/registry.ts check",
    "check": "tsc --noEmit && vitest run && node tools/registry.ts check && node tools/make-fixture.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@vercel/blob": "2.8.2",
    "fast-xml-parser": "5.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/RadMageIRL/TheSignal.git"
  },
  "homepage": "https://radmagelabs.com/signal/",
  "author": "RadMageIRL",
  "overrides": {
    "zod": "4.6.7"
  }
}
